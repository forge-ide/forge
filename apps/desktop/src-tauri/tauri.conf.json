{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forge",
  "version": "0.0.0",
  "identifier": "dev.forge-ide.forge",
  "build": {
    "beforeDevCommand": "pnpm --filter @forge/ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @forge/ui build",
    "frontendDist": "../../../packages/ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Forge",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
